<Window x:Class="AppTranslator.App.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bản dịch vùng"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" Background="#FF101010" BorderBrush="#FFF2C14E" BorderThickness="1"
        MouseLeftButtonUp="OnClick">
    <StackPanel Margin="12,8" MaxWidth="640">
        <TextBlock x:Name="TranslationText" Foreground="White" FontSize="20" TextWrapping="Wrap" />
        <TextBlock x:Name="SourceText" Foreground="#FFAAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
</Window>

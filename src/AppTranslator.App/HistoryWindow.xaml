<Window x:Class="AppTranslator.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch sử dịch" Width="1000" Height="600">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Làm mới" Width="90" Click="OnRefreshClick" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Giờ" Binding="{Binding Time}" Width="70" />
                <DataGridTextColumn Header="Tiếng Anh" Binding="{Binding Source}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Bản dịch" Binding="{Binding Translation}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Nguồn" Binding="{Binding Origin}" Width="60" />
                <DataGridTextColumn Header="OCR (ms)" Binding="{Binding OcrMs}" Width="70" />
                <DataGridTextColumn Header="Dịch (ms)" Binding="{Binding TranslateMs}" Width="70" />
                <DataGridTextColumn Header="Tổng (ms)" Binding="{Binding TotalMs}" Width="75" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

<Window x:Class="AppTranslator.App.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn vùng chữ" Width="1280" Height="800" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="Loại vùng:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="RegionTypeBox" Width="140" />
            <TextBlock Text="Kéo chuột trên ảnh để khoanh vùng. Xanh = phụ đề, vàng = lựa chọn hội thoại."
                       VerticalAlignment="Center" Margin="12,0" />
            <Button Content="Lưu" Width="80" Margin="0,0,6,0" IsDefault="True" Click="OnSaveClick" />
            <Button Content="Hủy" Width="80" IsCancel="True" />
        </StackPanel>
        <Viewbox Stretch="Uniform" Margin="8">
            <Grid>
                <Image x:Name="ScreenshotImage" Stretch="None" />
                <Canvas x:Name="SelectionCanvas" Background="Transparent"
                        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp" />
            </Grid>
        </Viewbox>
    </DockPanel>
</Window>

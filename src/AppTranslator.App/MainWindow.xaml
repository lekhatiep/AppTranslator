<Window x:Class="AppTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppTranslator" Width="560" SizeToContent="Height">
    <StackPanel Margin="16">
        <TextBlock Text="Hồ sơ game" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Tạo mới" Width="70" Margin="6,0,0,0" Command="{Binding NewProfileCommand}" />
            <Button DockPanel.Dock="Right" Content="Sửa" Width="60" Margin="6,0,0,0" Command="{Binding EditProfileCommand}" />
            <ComboBox ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}"
                      DisplayMemberPath="GameName" />
        </DockPanel>

        <TextBlock Text="Cửa sổ nguồn" Margin="0,12,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Làm mới" Width="80" Margin="6,0,0,0"
                    Command="{Binding RefreshWindowsCommand}" />
            <ComboBox ItemsSource="{Binding Windows}"
                      SelectedItem="{Binding SelectedWindow}"
                      DisplayMemberPath="DisplayName" />
        </DockPanel>

        <TextBlock Text="Cách chụp" Margin="0,12,0,4" />
        <ComboBox ItemsSource="{Binding CaptureEngines}"
                  SelectedItem="{Binding SelectedCaptureEngine}" />
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="WindowsGraphicsCapture: chụp cả khi cửa sổ bị che, click chuột xuyên qua chữ dịch, nhưng Windows 10 hiện viền vàng. DesktopDuplication: không viền vàng, nhưng cửa sổ game phải nằm trên cùng và click trúng ô chữ dịch sẽ bị bỏ qua (click chỗ khác vẫn vào game)." />

        <TextBlock Text="Bộ dịch" Margin="0,12,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Xóa cache hồ sơ" Width="120" Margin="6,0,0,0"
                    Command="{Binding ClearCacheCommand}" />
            <ComboBox ItemsSource="{Binding TranslatorProviders}"
                      SelectedItem="{Binding SelectedTranslatorProvider}" />
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Key Gemini" VerticalAlignment="Center" Width="80" />
            <Button DockPanel.Dock="Right" Content="Lưu key" Width="80" Margin="6,0,0,0" Click="OnSaveApiKeyClick" />
            <PasswordBox x:Name="ApiKeyBox" />
        </DockPanel>
        <TextBlock FontSize="11" Foreground="Gray" Text="{Binding ApiKeyHint}" Margin="0,4,0,0" />

        <CheckBox Content="Bật dịch (hiện overlay)" IsChecked="{Binding IsTranslationEnabled}" Margin="0,16,0,0" />
        <TextBlock FontSize="11" Foreground="Gray" Text="{Binding HotkeyHint}" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Chọn vùng chữ" Width="140" Margin="0,0,8,0" Command="{Binding SelectRegionsCommand}" />
            <Button Content="Lưu PNG debug" Width="140" Margin="0,0,8,0" Command="{Binding SaveDebugImagesCommand}" />
            <Button Content="Lịch sử dịch" Width="120" Margin="0,0,8,0" Command="{Binding OpenHistoryCommand}" />
            <Button Content="Cài đặt" Width="90" Command="{Binding OpenSettingsCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" />

        <TextBlock Text="Phụ đề vừa đọc (tiếng Anh)" FontWeight="SemiBold" Margin="0,16,0,4" />
        <TextBox Text="{Binding LastSubtitle, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" />
        <TextBlock FontSize="11" Foreground="Gray" Text="{Binding LastSubtitleTiming}" Margin="0,4,0,0" />

        <TextBlock Text="Bản dịch" FontWeight="SemiBold" Margin="0,12,0,4" />
        <TextBox Text="{Binding LastTranslation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" />
        <TextBlock FontSize="11" Foreground="Gray" Text="{Binding LastTranslationTiming}" Margin="0,4,0,0" />

        <TextBlock Text="Lựa chọn hội thoại (Anh → Việt)" FontWeight="SemiBold" Margin="0,12,0,4" />
        <TextBox Text="{Binding LastChoices, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" />
    </StackPanel>
</Window>

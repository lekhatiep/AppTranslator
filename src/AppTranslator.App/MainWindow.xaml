<Window x:Class="AppTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppTranslator" Width="560" SizeToContent="Height">
    <StackPanel Margin="16">
        <TextBlock Text="Hồ sơ game" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Profiles}"
                  SelectedItem="{Binding SelectedProfile}"
                  DisplayMemberPath="GameName" />

        <TextBlock Text="Cửa sổ nguồn" Margin="0,12,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Làm mới" Width="80" Margin="6,0,0,0"
                    Command="{Binding RefreshWindowsCommand}" />
            <ComboBox ItemsSource="{Binding Windows}"
                      SelectedItem="{Binding SelectedWindow}"
                      DisplayMemberPath="DisplayName" />
        </DockPanel>

        <TextBlock Text="Cách chụp" Margin="0,12,0,4" />
        <ComboBox ItemsSource="{Binding CaptureEngines}"
                  SelectedItem="{Binding SelectedCaptureEngine}" />
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="WindowsGraphicsCapture: chụp cả khi cửa sổ bị che, nhưng Windows 10 hiện viền vàng. DesktopDuplication: không viền, nhưng cửa sổ phải đang hiện trên màn hình." />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Chọn vùng chữ" Width="140" Margin="0,0,8,0" Command="{Binding SelectRegionsCommand}" />
            <Button Content="Lưu PNG debug" Width="140" Command="{Binding SaveDebugImagesCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
</Window>

<Window x:Class="AppTranslator.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Chữ dịch trên overlay" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Cỡ chữ (12–72)" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="FontSizeBox" Margin="0,2" />
            <TextBlock Grid.Row="1" Text="Màu nền (#RRGGBB)" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BackgroundColorBox" Margin="0,2" />
            <TextBlock Grid.Row="2" Text="Độ mờ nền" VerticalAlignment="Center" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                <TextBlock DockPanel.Dock="Right" x:Name="OpacityText" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="OnOpacityChanged" />
            </DockPanel>
        </Grid>
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Nền mờ quá thấp thì phụ đề tiếng Anh gốc lộ qua và chồng lên chữ dịch." />

        <TextBlock Text="Phím tắt (vd Ctrl+Alt+T, Ctrl+Shift+F2)" FontWeight="SemiBold" Margin="0,16,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Bật/tắt dịch" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ToggleHotkeyBox" Margin="0,2" />
            <TextBlock Grid.Row="1" Text="Chọn vùng chữ" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SelectRegionHotkeyBox" Margin="0,2" />
            <TextBlock Grid.Row="2" Text="Khoanh vùng dịch" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TranslateAreaHotkeyBox" Margin="0,2" />
        </Grid>

        <TextBlock Text="Dịch" FontWeight="SemiBold" Margin="0,16,0,6" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="Model Gemini" Width="140" VerticalAlignment="Center" />
            <TextBox x:Name="GeminiModelBox" />
        </DockPanel>
        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Bộ dịch và key Gemini chọn ở cửa sổ chính. Đổi model thì bản dịch đã lưu trong cache vẫn được dùng lại." />

        <TextBlock x:Name="ErrorText" Foreground="#FFC62828" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Lưu" Width="80" Margin="0,0,6,0" IsDefault="True" Click="OnSaveClick" />
            <Button Content="Hủy" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
